<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_multileads" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.multileads</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="100"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">

                    <app data-string="Leads multiconector" string="Leads multiconector" name="odoo_multileads">
                        <block title="Plataformas" name="channels_setting">
                            <setting string="Facebook" help="Recibe prospectos desde formularios de Facebook.">
                                <field name="blazar_enable_facebook"/>

                                <div class="mt8 mb8">
                                    <i class="fa fa-facebook-square" style="color: #1877F2; font-size: 28px;"/>
                                </div>

                                <div class="content-group mt16" invisible="not blazar_enable_facebook">
                                    <div class="row mt8">
                                        <label for="blazar_fb_verify_token" class="col-4 o_light_label"/>
                                        <field name="blazar_fb_verify_token" class="col-8 oe_inline"/>
                                    </div>
                                </div>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>